<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:elevation="4dp"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LANU Sesli Notlar"
                android:textColor="#C62828"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Son Notlar ve Hızlı Kayıt"
                android:textColor="#757575"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Quick Mic button -->
        <ImageButton
            android:id="@+id/btn_widget_mic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@android:color/holo_red_light"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="Hızlı Ses Kaydı" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="8dp" />

    <!-- Static List of Top 3 Notes -->
    <LinearLayout
        android:id="@+id/layout_notes_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Slot 1 -->
        <LinearLayout
            android:id="@+id/widget_note_slot_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp"
            android:layout_marginBottom="4dp"
            android:background="#F5F5F5"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/txt_note_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#212121"
                android:singleLine="true"
                android:text="Not 1" />
            <TextView
                android:id="@+id/txt_note_content_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#616161"
                android:singleLine="true"
                android:text="İçerik 1" />
        </LinearLayout>

        <!-- Slot 2 -->
        <LinearLayout
            android:id="@+id/widget_note_slot_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp"
            android:layout_marginBottom="4dp"
            android:background="#F5F5F5"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/txt_note_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#212121"
                android:singleLine="true"
                android:text="Not 2" />
            <TextView
                android:id="@+id/txt_note_content_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#616161"
                android:singleLine="true"
                android:text="İçerik 2" />
        </LinearLayout>

        <!-- Slot 3 -->
        <LinearLayout
            android:id="@+id/widget_note_slot_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="#F5F5F5"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/txt_note_title_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#212121"
                android:singleLine="true"
                android:text="Not 3" />
            <TextView
                android:id="@+id/txt_note_content_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#616161"
                android:singleLine="true"
                android:text="İçerik 3" />
        </LinearLayout>

        <!-- Empty State Label -->
        <TextView
            android:id="@+id/txt_widget_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:text="Henüz kaydedilmiş not yok."
            android:textColor="#9E9E9E"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
